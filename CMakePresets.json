{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "default",
      "displayName": "Debug",
      "description": "Debug build with full debugging symbols",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "default",
      "displayName": "Release",
      "description": "Optimized release build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "relwithdebinfo",
      "inherits": "default",
      "displayName": "Release with Debug Info",
      "description": "Optimized build with debugging symbols",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "asan",
      "inherits": "debug",
      "displayName": "Debug + AddressSanitizer",
      "description": "Debug build with AddressSanitizer enabled",
      "cacheVariables": {
        "LIBFABRIC_ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "tsan",
      "inherits": "debug",
      "displayName": "Debug + ThreadSanitizer",
      "description": "Debug build with ThreadSanitizer enabled",
      "cacheVariables": {
        "LIBFABRIC_ENABLE_TSAN": "ON"
      }
    },
    {
      "name": "ubsan",
      "inherits": "debug",
      "displayName": "Debug + UndefinedBehaviorSanitizer",
      "description": "Debug build with UndefinedBehaviorSanitizer enabled",
      "cacheVariables": {
        "LIBFABRIC_ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "clang-tidy",
      "inherits": "debug",
      "displayName": "Clang-Tidy Analysis",
      "description": "Run clang-tidy alongside Clang compilation",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_C_CLANG_TIDY": "clang-tidy;--config-file=${sourceDir}/.clang-tidy",
        "CMAKE_CXX_CLANG_TIDY": "clang-tidy;--config-file=${sourceDir}/.clang-tidy"
      }
    },
    {
      "name": "iwyu",
      "inherits": "debug",
      "displayName": "Include-What-You-Use Analysis",
      "description": "Report include dependencies alongside Clang compilation",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_C_INCLUDE_WHAT_YOU_USE": "include-what-you-use;-Xiwyu;--keep=*/config.h",
        "CMAKE_CXX_INCLUDE_WHAT_YOU_USE": "include-what-you-use;-Xiwyu;--keep=*/config.h"
      }
    },
    {
      "name": "minimal",
      "inherits": "release",
      "displayName": "Minimal (tcp, sockets only)",
      "description": "Minimal build with only tcp and sockets providers",
      "cacheVariables": {
        "LIBFABRIC_PROVIDER_VERBS": "OFF",
        "LIBFABRIC_PROVIDER_EFA": "OFF",
        "LIBFABRIC_PROVIDER_PSM2": "OFF",
        "LIBFABRIC_PROVIDER_PSM3": "OFF",
        "LIBFABRIC_PROVIDER_OPX": "OFF",
        "LIBFABRIC_PROVIDER_CXI": "OFF",
        "LIBFABRIC_PROVIDER_UCX": "OFF",
        "LIBFABRIC_PROVIDER_USNIC": "OFF",
        "LIBFABRIC_PROVIDER_LPP": "OFF",
        "LIBFABRIC_PROVIDER_SHM": "OFF",
        "LIBFABRIC_PROVIDER_SM2": "OFF",
        "LIBFABRIC_PROVIDER_LNX": "OFF",
        "LIBFABRIC_PROVIDER_RXM": "OFF",
        "LIBFABRIC_PROVIDER_RXD": "OFF",
        "LIBFABRIC_PROVIDER_MRAIL": "OFF",
        "LIBFABRIC_PROVIDER_UDP": "OFF"
      }
    },
    {
      "name": "static",
      "inherits": "release",
      "displayName": "Static Library Only",
      "description": "Build only the static library",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF"
      }
    },
    {
      "name": "ci-linux",
      "inherits": "release",
      "displayName": "CI Linux Build",
      "description": "Build configuration for Linux CI",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install"
      }
    },
    {
      "name": "ci-macos",
      "inherits": "release",
      "displayName": "CI macOS Build",
      "description": "Build configuration for macOS CI",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install",
        "LIBFABRIC_PROVIDER_VERBS": "OFF",
        "LIBFABRIC_PROVIDER_EFA": "OFF",
        "LIBFABRIC_PROVIDER_PSM2": "OFF",
        "LIBFABRIC_PROVIDER_PSM3": "OFF",
        "LIBFABRIC_PROVIDER_OPX": "OFF",
        "LIBFABRIC_PROVIDER_CXI": "OFF",
        "LIBFABRIC_PROVIDER_UCX": "OFF",
        "LIBFABRIC_PROVIDER_USNIC": "OFF",
        "LIBFABRIC_PROVIDER_LPP": "OFF",
        "LIBFABRIC_PROVIDER_SHM": "OFF",
        "LIBFABRIC_PROVIDER_SM2": "OFF",
        "LIBFABRIC_PROVIDER_LNX": "ON"
      }
    },
    {
      "name": "ci-windows",
      "displayName": "CI Windows Build",
      "description": "Build configuration for Windows CI",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "LIBFABRIC_PROVIDER_VERBS": "OFF",
        "LIBFABRIC_PROVIDER_EFA": "OFF",
        "LIBFABRIC_PROVIDER_PSM2": "OFF",
        "LIBFABRIC_PROVIDER_PSM3": "OFF",
        "LIBFABRIC_PROVIDER_OPX": "OFF",
        "LIBFABRIC_PROVIDER_CXI": "OFF",
        "LIBFABRIC_PROVIDER_UCX": "OFF",
        "LIBFABRIC_PROVIDER_USNIC": "OFF",
        "LIBFABRIC_PROVIDER_LPP": "OFF",
        "LIBFABRIC_PROVIDER_SHM": "OFF",
        "LIBFABRIC_PROVIDER_SM2": "OFF",
        "LIBFABRIC_PROVIDER_LNX": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "relwithdebinfo",
      "configurePreset": "relwithdebinfo"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    },
    {
      "name": "ubsan",
      "configurePreset": "ubsan"
    },
    {
      "name": "minimal",
      "configurePreset": "minimal"
    },
    {
      "name": "static",
      "configurePreset": "static"
    },
    {
      "name": "ci-linux",
      "configurePreset": "ci-linux"
    },
    {
      "name": "ci-macos",
      "configurePreset": "ci-macos"
    },
    {
      "name": "ci-windows",
      "configurePreset": "ci-windows",
      "configuration": "Release"
    },
    {
      "name": "clang-tidy",
      "configurePreset": "clang-tidy"
    },
    {
      "name": "iwyu",
      "configurePreset": "iwyu"
    }
  ]
}
