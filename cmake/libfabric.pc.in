prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: libfabric
Description: OFI-WG libfabric
URL: https://github.com/ofiwg/libfabric.git
Version: @PACKAGE_VERSION@
Requires:
Cflags: -I${includedir}
Libs: -L${libdir} -lfabric @LIBFABRIC_PKGCONFIG_LINK_OPTIONS@
Libs.private: @LIBS_PRIVATE@
Requires.private: @LIBFABRIC_PC_REQUIRES_PRIVATE@
