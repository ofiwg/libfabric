    fi_wr wr, \f[B]enum\f[R] fi_op_type op_type, uint64_t flags, int scope);
.EE
.SS Completion Functions
Device\-side completion functions operate on exported CQ and counter
handles.
See the following man pages for function signatures and semantics:
.IP \(bu 2
Counter operations (fi_xpu_cntr_read, fi_xpu_cntr_wait, etc.):
\f[CR]fi_cntr\f[R](3)
.IP \(bu 2
CQ operations (fi_xpu_cq_read, fi_xpu_cq_readerr, etc.):
\f[CR]fi_cq\f[R](3)
.SH EXAMPLE
The following illustrates the typical host\-side setup flow for
XPU\-initiated RDMA communication using the XPU context:
.IP
.EX
\f[I]/* 1. Query provider for FI_XPU support */\f[R]
\f[B]struct\f[R] fi_info *hints = fi_allocinfo();
hints\->caps = FI_MSG | FI_RMA | FI_XPU;
fi_getinfo(FI_VERSION(2,7), NULL, NULL, 0, hints, &info);
\f[I]/* info\->domain_attr\->max_xpu_ctx_cnt > 0 confirms support */\f[R]

\f[I]/* 2. Open domain */\f[R]
fi_domain(fabric, info, &domain, NULL);

\f[I]/* 3. Create XPU context for GPU 0 (with memory callbacks) */\f[R]
\f[B]struct\f[R] fi_xpu_ops my_ops = {
    .size = \f[B]sizeof\f[R](\f[B]struct\f[R] fi_xpu_ops),
    .alloc = my_cuda_alloc,
    .import = my_cuda_import,
    .free = my_cuda_free,
};
\f[B]struct\f[R] fi_xpu_attr xpu_attr = {
    .iface = FI_HMEM_CUDA,
    .device = 0,
    .ops = &my_ops,
};
\f[B]struct\f[R] fid_xpu_ctx *xpu_ctx;
fi_xpu_ctx(domain, &xpu_attr, &xpu_ctx, NULL);

\f[I]/* 4. Query context for sizes and capabilities */\f[R]
\f[B]struct\f[R] fi_xpu_ctx_attr ctx_attr;
fi_xpu_ctx_query(xpu_ctx, &ctx_attr);
\f[I]/* ctx_attr.caps indicates supported objects (FI_XPU_CAP_EP, etc.) */\f[R]
size_t av_entry_size = ctx_attr.av_addr_size;
size_t desc_size = ctx_attr.mr_desc_size;

\f[I]/* 5. Create AV (domain\-level, no xpu_ctx binding) */\f[R]
\f[B]struct\f[R] fi_av_attr av_attr = { .type = FI_AV_TABLE };
fi_av_open(domain, &av_attr, &av, NULL);
fi_av_insert(av, peer_addr, 1, &fi_addr, 0, NULL);

\f[I]/* 6. Create CQ and counter with xpu_ctx */\f[R]
\f[B]struct\f[R] fi_cq_attr cq_attr = { .format = FI_CQ_FORMAT_DATA,
                              .xpu_ctx = xpu_ctx };
fi_cq_open(domain, &cq_attr, &cq, NULL);

\f[B]struct\f[R] fi_cntr_attr cntr_attr = { .events = FI_CNTR_EVENTS_COMP,
                                  .xpu_ctx = xpu_ctx };
fi_cntr_open(domain, &cntr_attr, &cntr, NULL);

\f[I]/* 7. Create EP with xpu_ctx */\f[R]
info\->ep_attr\->xpu_ctx = xpu_ctx;
fi_endpoint2(domain, info, &ep, FI_XPU, NULL);

\f[I]/* 8. Register MR (domain\-level, no special flags) */\f[R]
\f[B]struct\f[R] fi_mr_attr mr_attr = { .mr_iov = &iov, .iov_count = 1,
                              .access = FI_SEND | FI_RECV };
fi_mr_regattr(domain, &mr_attr, 0, &mr);

\f[I]/* 9. Bind and enable EP */\f[R]
fi_ep_bind(ep, &av\->fid, 0);
fi_ep_bind(ep, &cq\->fid, FI_TRANSMIT | FI_RECV);
fi_ep_bind(ep, &cntr\->fid, FI_SEND);
fi_enable(ep);

\f[I]/* 10. Export EP/CQ/counter for device\-side use */\f[R]
\f[B]struct\f[R] fid_xpu_ep xpu_ep;
\f[B]struct\f[R] fid_xpu_cq xpu_cq;
\f[B]struct\f[R] fid_xpu_cntr xpu_cntr;
fi_ep_export_xpu(ep, 0, &xpu_ep);
fi_cq_export_xpu(cq, 0, &xpu_cq);
fi_cntr_export_xpu(cntr, 0, &xpu_cntr);

\f[I]/* 11. Get raw AV addr and MR desc for device\-side use */\f[R]
void *raw_addr = malloc(av_entry_size);
size_t len = av_entry_size;
fi_av_lookup2(av, fi_addr, raw_addr, &len, FI_XPU, xpu_ctx);

void *raw_desc = malloc(desc_size);
len = desc_size;
fi_mr_get_xpu_desc(mr, raw_desc, &len, FI_XPU, xpu_ctx);

\f[I]/* 12. Copy raw AV addr, MR desc, and exported handles to device memory */\f[R]
copy_to_device(gpu_addr, raw_addr, av_entry_size);
copy_to_device(gpu_desc, raw_desc, desc_size);
copy_to_device(gpu_xpu_ep, &xpu_ep, \f[B]sizeof\f[R](xpu_ep));
copy_to_device(gpu_xpu_cntr, &xpu_cntr, \f[B]sizeof\f[R](xpu_cntr));

\f[I]/* 13. Launch device kernel \(em posts operations and polls completions\f[R]
\f[I] *     using exported handles (already device\-accessible):\f[R]
\f[I] *\f[R]
\f[I] *     __global__ void my_kernel(struct fid_xpu_ep *ep,\f[R]
\f[I] *                               struct fid_xpu_cntr *cntr,\f[R]
\f[I] *                               void *peer, void *desc, void *buf) {\f[R]
\f[I] *         uint64_t prev = fi_xpu_cntr_read(cntr, FI_XPU_WORK_ITEM);\f[R]
\f[I] *\f[R]
\f[I] *         fi_xpu_send(ep, buf, 64, desc, 0, peer, NULL,\f[R]
\f[I] *                     0, FI_XPU_WORK_ITEM);\f[R]
\f[I] *\f[R]
\f[I] *         fi_xpu_cntr_wait(cntr, prev + 1, \-1, FI_XPU_WORK_ITEM);\f[R]
\f[I] *     }\f[R]
\f[I] */\f[R]
launch_kernel(my_kernel, gpu_xpu_ep, gpu_xpu_cntr, gpu_addr, gpu_desc, gpu_buf);

\f[I]/* 14. Cleanup */\f[R]
fi_close(&ep\->fid);
fi_close(&cq\->fid);
fi_close(&cntr\->fid);
fi_close(&mr\->fid);
fi_close(&av\->fid);
fi_close(&xpu_ctx\->fid);
fi_close(&domain\->fid);
.EE
