.SS Data Transfer Operations
Device\-side data transfer operations correspond to the standard
libfabric APIs.
See the following man pages for function signatures and semantics:
.IP \(bu 2
Message operations (fi_xpu_send, fi_xpu_recv): \f[CR]fi_msg\f[R](3)
.IP \(bu 2
Tagged operations (fi_xpu_tsend, fi_xpu_trecv): \f[CR]fi_tagged\f[R](3)
.IP \(bu 2
RMA operations (fi_xpu_write, fi_xpu_read): \f[CR]fi_rma\f[R](3)
.IP \(bu 2
Atomic operations (fi_xpu_atomic, fi_xpu_fetch_atomic,
fi_xpu_compare_atomic): \f[CR]fi_atomic\f[R](3)
.SS Work Requests
The device\-side data transfer operations above both format and issue
the operation from device code.
Work requests split that lifecycle into prepare, modify, queue, and
flush, exactly as the host interface does.
A work request can be prepared either on the device with
\f[CR]fi_xpu_wr_prepare\f[R], or on the host with
\f[CR]fi_wr_prepare\f[R] and then copied into device memory, and in both
cases it is subsequently modified and queued from device code.
.IP
.EX
FI_XPU_FUNC int fi_xpu_wr_prepare(\f[B]struct\f[R] fid_xpu_ep *ep,
    const \f[B]struct\f[R] fi_wr_attr *attr, fi_wr wr, size_t *wr_len,
    int scope);
FI_XPU_FUNC int fi_xpu_wr_queue_tx(\f[B]struct\f[R] fid_xpu_ep *ep,
    const fi_wr wr, void *context, int scope);
FI_XPU_FUNC int fi_xpu_wr_queue_recv(\f[B]struct\f[R] fid_xpu_ep *ep,
    const fi_wr wr, void *context, int scope);
FI_XPU_FUNC int fi_xpu_wr_queue_trecv(\f[B]struct\f[R] fid_xpu_ep *ep,
    const fi_wr wr, void *context, int scope);
FI_XPU_FUNC int fi_xpu_tx_flush(\f[B]struct\f[R] fid_xpu_ep *ep, uint64_t flags,
    int scope);
FI_XPU_FUNC int fi_xpu_recv_flush(\f[B]struct\f[R] fid_xpu_ep *ep, uint64_t flags,
    int scope);
FI_XPU_FUNC int fi_xpu_trecv_flush(\f[B]struct\f[R] fid_xpu_ep *ep, uint64_t flags,
    int scope);

FI_XPU_FUNC int fi_xpu_wr_modify_addr(\f[B]struct\f[R] fid_xpu_ep *ep,
    fi_wr wr, \f[B]enum\f[R] fi_op_type op_type, const void *xpu_addr,
    int scope);
FI_XPU_FUNC int fi_xpu_wr_modify_iov(\f[B]struct\f[R] fid_xpu_ep *ep,
    fi_wr wr, \f[B]enum\f[R] fi_op_type op_type, const \f[B]struct\f[R] iovec *iov,
    const void *desc, size_t count, int scope);
FI_XPU_FUNC int fi_xpu_wr_modify_rma_iov(\f[B]struct\f[R] fid_xpu_ep *ep,
    fi_wr wr, \f[B]enum\f[R] fi_op_type op_type,
    const \f[B]struct\f[R] fi_rma_iov *rma_iov, size_t count, int scope);
FI_XPU_FUNC int fi_xpu_wr_modify_tag(\f[B]struct\f[R] fid_xpu_ep *ep,
    fi_wr wr, \f[B]enum\f[R] fi_op_type op_type, uint64_t tag,
    uint64_t ignore, int scope);
